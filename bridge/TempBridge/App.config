<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!--
      TempBridge 是一个常驻后台的小进程：绝大多数时间在等下一条 GetTemperature，
      每秒只处理一次请求，存活堆只有几百 KB。

      并发（后台）GC 为此额外常驻一个 GC 线程，并为后台标记预留/提交更多内存，
      换来的是"长时间 gen2 暂停"的规避——而这个进程的 gen2 堆小到根本不会产生
      可感知的暂停。关掉它可以少一个常驻线程、降低提交内存，且不影响响应延迟。

      服务器 GC 会按 CPU 核心数各建一个堆和一个 GC 线程，对本进程只有害处，
      这里显式声明关闭以免受机器级 runtime 配置影响。
    -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="false" />
  </runtime>
</configuration>
