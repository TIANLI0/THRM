# Bundled PawnIO installer, pinned for reproducible builds. Single source for:
#   build_bridge.bat  (download URL + SHA-256 check),
#   Taskfile.yml      (package task: fluentsetup -D PawnIOVersion=...),
#   CI                ("Rebuild the installer from signed binaries").
# To upgrade: pick a release at https://github.com/namazso/PawnIO.Setup/releases,
# download PawnIO_setup.exe, then update all three values below:
#   PAWNIO_VERSION       release tag
#   PAWNIO_FILE_VERSION  4-part FileVersion of PawnIO_setup.exe (what the installer compares
#                        against the installed PawnIO DisplayVersion)
#   PAWNIO_SHA256        Get-FileHash PawnIO_setup.exe -Algorithm SHA256 (lower case)
PAWNIO_VERSION=2.2.0
PAWNIO_FILE_VERSION=2.2.0.0
PAWNIO_SHA256=1f519a22e47187f70a1379a48ca604981c4fcf694f4e65b734aaa74a9fba3032
